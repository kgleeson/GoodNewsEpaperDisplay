# Copy to .env and fill in your secrets
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORG=

# Display device (omni-epd device string)
# Use omni_epd.mock for local dev/testing without hardware
# Use waveshare_epd.epd7in3f for the Waveshare 7.3" 7-color display on Pi
EPAPER_DEVICE=omni_epd.mock

# AI models
# NOTE: the production Pi's .env sets EPAPER_TEXT_MODEL / EPAPER_IMAGE_MODEL explicitly,
# which overrides these defaults. Update (or remove) those lines there when deploying.
# Text model: gpt-6-luna (reasoning). Fallback: gpt-5.6-luna (OpenAI's named gpt-5-nano
# replacement). For a non-reasoning model, set both *_REASONING_EFFORT values to empty.
# EPAPER_TEXT_MODEL=gpt-6-luna
# EPAPER_POSITIVITY_REASONING_EFFORT=none
# EPAPER_HEADLINE_REASONING_EFFORT=low
# Image model: gpt-image-2.5-sunburst (alternative: gpt-image-2.5-flare)
# EPAPER_IMAGE_MODEL=gpt-image-2.5-sunburst
# 1600x960 is exactly 5:3 (2x the 800x480 panel). gpt-image-2+ accepts custom WxH
# (edges multiple of 16, ratio <= 3:1, longest edge <= 3840, 655,360-8,294,400 pixels);
# gpt-image-1 family only accepts 1024x1024, 1536x1024, 1024x1536 or auto.
# EPAPER_IMAGE_SIZE=1600x960
# EPAPER_IMAGE_QUALITY=high

# Storage and scheduling
# EPAPER_DATA_DIR=/path/to/data
# EPAPER_SCHEDULE_HOUR=8
# EPAPER_SCHEDULE_MINUTE=0
# EPAPER_TIMEZONE=Europe/Dublin

# Web server
# EPAPER_WEB_HOST=0.0.0.0
# EPAPER_WEB_PORT=8000

# News feed
# EPAPER_RSS_FEED_URL=https://www.rte.ie/feeds/rss/?index=%2Fnews%2F

# Positivity filter tuning
# All fetched articles are scored; up to SELECT_COUNT with score >= MIN_SCORE are used.
# If none pass, the run is skipped and yesterday's image is re-displayed.
# (EPAPER_POSITIVITY_SAMPLE_SIZE is no longer used.)
# EPAPER_POSITIVITY_SELECT_COUNT=3
# EPAPER_POSITIVITY_MIN_SCORE=0.6
